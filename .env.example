# Database
POSTGRES_USER=veroscribe
POSTGRES_PASSWORD=veroscribe
POSTGRES_DB=veroscribe
DB_PORT=5432
DATABASE_URL=postgres://veroscribe:veroscribe@localhost:5432/veroscribe

# API
API_PORT=3001
CORS_ORIGINS=http://localhost:3000

# Web
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Dev-mode file watching for Docker on macOS/Windows hosts
WATCHPACK_POLLING=true
CHOKIDAR_USEPOLLING=true

# Misc
NODE_ENV=development
