{
  "name": "veroscribe",
  "private": true,
  "packageManager": "bun@1.2.21",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:reset": "bun --filter=@veroscribe/db run reset",
    "db:generate": "bun --filter=@veroscribe/db run generate",
    "db:push": "bun --filter=@veroscribe/db run push",
    "db:migrate": "bun --filter=@veroscribe/db run migrate",
    "db:seed": "bun --filter=@veroscribe/db run seed",
    "db:studio": "bun --filter=@veroscribe/db run studio"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.6.0"
  }
}
